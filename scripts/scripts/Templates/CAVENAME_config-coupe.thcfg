encoding  utf-8
input ../../config2.thcfg
input ../../../layouts/config3.thcfg
source <CAVENAME>_tot.th


################################## Selection de la map à exporter #################################
select MC_<CAVENAME>@<CAVENAME>-tot      #uncomment ONLY one


#export map \
     -projection extended \
     -layout coupe \
     -output exports/<CAVENAME>_coupe.pdf \

### Stations             # l'ordre des layouts est importants !
#export map \
     -projection extended \
     -layout coupe \
     -layout centerline \
     -output exports/<CAVENAME>_coupe-travail.pdf \

### Debug
#export map \
     -projection extended \
     -layout coupe   \
     -layout-debug all \
     -output exports/<CAVENAME>_DEBUG_coupe.pdf
