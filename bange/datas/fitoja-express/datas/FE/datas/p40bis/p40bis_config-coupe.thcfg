encoding  utf-8
input ../../config2.thcfg
input ../../../layouts/config3.thcfg
source p40bis_tot.th


################################## Selection de la map à exporter #################################
select MC_p40bis@p40bis-tot      #uncomment ONLY one


#export map \
     -projection extended \
     -layout coupe \
     -output exports/p40bis_coupe.pdf \

### Stations             # l'ordre des layouts est importants !
#export map \
     -projection extended \
     -layout coupe \
     -layout centerline \
     -output exports/p40bis_coupe-travail.pdf \

### Debug
#export map \
     -projection extended \
     -layout coupe   \
     -layout-debug all \
     -output exports/p40bis_DEBUG_coupe.pdf
