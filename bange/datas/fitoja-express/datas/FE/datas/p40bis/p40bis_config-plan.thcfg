encoding  utf-8
input ../../config2.thcfg
input ../../../layouts/config3.thcfg
source p40bis_tot.th

################################## Selection de la map à exporter #################################
select MP_p40bis@p40bis-tot       #uncomment ONLY one




### plan
export map \
     -projection plan \
     -layout plan \
     -output exports/p40bis_plan.pdf \

### stations      ## l'ordre des layouts est importants !
export map \
     -projection plan \
     -layout plan \
     -layout centerline \
     -output exports/p40bis_plan-travail.pdf \

### debug
#export map \
     -projection plan \
     -layout plan   \
     -layout-debug all \
     -output exports/p40bis_DEBUG_plan.pdf

### 3d
    #export model \
     -format loch \
     -o exports/p40bis-3d.lox \
     #-wall-source maps
     
### Exporte uniquement les murs
#export map \
     -projection plan \
     -layout walls   \
     -output exports/p40bis_walls.pdf \
     #-layout hide_point \
     #-layout-debug station-names \
     #-layout debug \
     #-layout centreline \


######################### ATLAS ########################
#export atlas \
     -projection plan \
     -layout plan   \
     -output exports/p40bis_Atlas.pdf 




######################## KML #######################
#export map \
     -projection plan \
     -output exports/p40bis.kml  ###-> Pour murs

#export model \
